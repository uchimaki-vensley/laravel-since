includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max

    # モデルの casts() の中身から属性の型（enum・array など）を読む。
    # 既定では casts() の戻り値の型（array<string, string>）しか見ないので、キャストした属性が string 扱いになる。
    parseModelCastsMethod: true

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    excludePaths:
        # 解析対象のソースを模したフィクスチャ。構文解析の入力としてだけ使い、実行しない。
        - tests/Fixtures/*
    tmpDir: storage/framework/cache/phpstan
